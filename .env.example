# Neon: Dashboard → project → Connection details → copy pooled or direct URI.
# Run db/schema.sql once, then add accounts with db/create-user.sql (see README → Accounts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Random secret for signing the session cookie (e.g. openssl rand -hex 32). Not a login password.
# Login is required whenever DATABASE_URL is set; leave DATABASE_URL empty locally to run without it.
AUTH_SECRET="random-long-secret-for-hmac-only"

# Net-worth milestone. Birth date, target and age are set per account in Settings.
# ExchangeRate-API key for USD→VND (cached in Postgres for 24h).
EXCHANGERATE_API_KEY=""
# Optional fixed rate that skips the API, e.g. 25900.
USD_VND_RATE=""
# Optional annual real return for projections (default 0.025).
REAL_RETURN_ANNUAL=""
