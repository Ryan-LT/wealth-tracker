# Neon: Dashboard → project → Connection details → copy pooled or direct URI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Single-user app login (leave unset locally to disable the gate during development).
AUTH_USERNAME="you"
AUTH_PASSWORD="use-a-strong-password"
# Random secret for signing the session cookie (e.g. openssl rand -hex 32). Not your login password.
AUTH_SECRET="random-long-secret-for-hmac-only"

# "$1M by 35" milestone (optional).
# Your date of birth (YYYY-MM-DD) — sets the age-35 deadline.
USER_DATE_OF_BIRTH="1995-01-31"
# ExchangeRate-API key for USD→VND (cached in Postgres for 24h).
EXCHANGERATE_API_KEY=""
# Optional fixed rate that skips the API, e.g. 25900.
USD_VND_RATE=""
# Optional milestone target in USD (default 1000000).
WEALTH_MILESTONE_TARGET_USD=""
