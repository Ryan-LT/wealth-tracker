# Neon: Dashboard → project → Connection details → copy pooled or direct URI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Single-user app login (leave unset locally to disable the gate during development).
AUTH_USERNAME="you"
AUTH_PASSWORD="use-a-strong-password"
# Random secret for signing the session cookie (e.g. openssl rand -hex 32). Not your login password.
AUTH_SECRET="random-long-secret-for-hmac-only"
